# Copy to .env beside compose.yaml (docs/self-hosting.md, "With Docker
# Compose").

# The name the relay and the web app are reached by. Its DNS must point at
# this machine, with ports 80 and 443 open, for Caddy's certificate.
# Passkeys are tied to it: choose one that can follow the server.
PIRC_DOMAIN=pirc.example.org

# The release to run, the latest on https://github.com/pirc-dev/pirc/releases,
# without the v (images exist for the releases after 0.3.4). Change it to
# upgrade, relay and web app together.
PIRC_VERSION=

# The push gateway that wakes PiRC's apps; empty for none (docs/gateway.md).
#PIRC_RELAY_PUSH_GATEWAY=https://push.pirc.dev
