# /etc/pirc-relay/env: pirc-relay serve's settings (docs/self-hosting.md).
# An empty value counts as unset.

# Where to listen: an address on the network your hosts and clients use.
PIRC_RELAY_LISTEN=127.0.0.1:8443

# TLS is required unless this is true: only on a network that already
# encrypts (a VPN), or behind a proxy that terminates TLS. For TLS, leave
# this false and add tls.conf.
PIRC_RELAY_PLAINTEXT=false

# Behind a proxy that terminates TLS: its addresses or CIDR prefixes,
# comma-separated. X-Forwarded-For is believed from these only, so that
# pending requests and the log show a peer's own address.
#PIRC_RELAY_TRUSTED_PROXIES=127.0.0.1

# The push gateway that wakes phones registered for notifications. PiRC's
# own, open to every relay, is the only one that can wake PiRC's apps from
# the stores; a push carries nothing (docs/gateway.md). Empty: no wakes.
PIRC_RELAY_PUSH_GATEWAY=https://push.pirc.dev

# True admits no new hosts but those added with pirc-relay add-host: none
# asks for approval, and apps cannot make host tokens. For a relay whose
# apps are not all yours, such as one for store review.
#PIRC_RELAY_CLOSED_TO_HOSTS=false

# The largest frame, in bytes, accepted or sent (default 16 MiB).
#PIRC_RELAY_MAX_FRAME_BYTES=16777216

# The relay's URL as hosts and phones reach it, which add-host and
# add-client --url print in the line or link to join by; serve does not
# use it. Read from here by the alias in docs/self-hosting.md.
#PIRC_RELAY_URL=wss://relay.example.org:8443
