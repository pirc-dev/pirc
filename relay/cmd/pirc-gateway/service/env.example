# /etc/pirc-gateway/env: pirc-gateway serve's settings (docs/gateway.md).
# An empty value counts as unset. The key and the push services'
# credentials are given by the unit and its drop-ins, not here.

# Where to listen, plain HTTP behind a proxy that terminates TLS.
PIRC_GATEWAY_LISTEN=127.0.0.1:8444

# That proxy's addresses or CIDR prefixes, comma-separated, so that the
# registration limit counts each phone's own address.
PIRC_GATEWAY_TRUSTED_PROXIES=127.0.0.1

# The apps served, by bundle ID and package name.
#PIRC_GATEWAY_APPS=dev.pirc.app
