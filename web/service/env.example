# /etc/pirc-web/env: pirc-web serve's settings (docs/web.md). An empty value
# counts as unset.

# The app's address as browsers see it. Passkeys are tied to its host name,
# and requests naming any other host are refused.
PIRC_WEB_ORIGIN=https://pirc.example

# Where to listen: an address on the network the browsers use.
PIRC_WEB_LISTEN=127.0.0.1:7402

# TLS (with HTTP/2) is required unless this is true: only behind a proxy
# that terminates TLS. For TLS, leave it false and set the two files, which
# must be readable by the pirc-web user, or add tls.conf as a drop-in.
PIRC_WEB_PLAINTEXT=false
#PIRC_WEB_TLS_CERT=
#PIRC_WEB_TLS_KEY=

# A private CA for the PiRC relay's certificate, if it has one.
#NODE_EXTRA_CA_CERTS=/etc/pirc-web/relay-ca.pem
