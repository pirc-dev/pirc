<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13 and later ask the person (Push.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <!-- FCM's wake (WakeService.kt). -->
        <service android:name="dev.pirc.platform.WakeService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
